# Copy to terraform.tfvars and fill in. That file is gitignored: it holds the API
# tokens, and so does terraform.tfstate once you apply.
#
#   cp terraform.tfvars.example terraform.tfvars

# --- Which AWS account this deploys into -------------------------------------
# Create the profile without touching your existing ones:
#     cp -a ~/.aws ~/.aws.backup-$(date +%F)
#     aws configure --profile stock-tracker
#     aws sts get-caller-identity --profile stock-tracker
#
# Put that account id below. Terraform then refuses to run against any other
# account, so a stale AWS_PROFILE cannot deploy this into the wrong place.
aws_profile         = "stock-tracker"
allowed_account_ids = ["111111111111"]

# --- API credentials ---------------------------------------------------------
brapi_token    = "your-brapi-token"
bolsai_api_key = "your-bolsai-api-key"
alpha_vantage_api_key = "your-alpha-vantage-key"   # US tickers; free, 25 req/day

alert_sender    = "alerts@yourdomain.com"
alert_recipient = "you@example.com"

# Deploy everything but do not let it run on its own until you have seeded a
# stock and invoked it by hand at least once.
schedule_enabled = false

# Daily snapshots cannot be rebuilt — no free provider serves historical prices.
# Turning this on costs a few cents a month and buys 35 days of restore.
# enable_point_in_time_recovery = true
