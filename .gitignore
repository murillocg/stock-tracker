# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Lambda build artefacts (regenerate with backend/scripts/build_lambda.sh)
backend/build/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
# terraform.tfvars holds API tokens. The .example file is not matched by this.
*.tfvars
# Holds the state bucket name, which embeds the AWS account id.
infra/backend.hcl
# A saved plan: a binary snapshot of proposed changes, and it can carry values
# from the state. Regenerate with `terraform plan -out=tfplan`.
infra/tfplan

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/

# OS / editors
.DS_Store
.idea/
.vscode/
